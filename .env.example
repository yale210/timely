# Copy this file to .env before running the production Docker Compose stack.
# Generate a secret with: python3 -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=replace-with-a-unique-random-value

# Public hostnames only, without a URL scheme. Separate multiple values with commas.
ALLOWED_HOSTS=example.com

# Origins include the scheme. CORS can remain empty for the default same-origin setup.
CSRF_TRUSTED_ORIGINS=https://example.com
CORS_ALLOWED_ORIGINS=

POSTGRES_DB=timely
POSTGRES_USER=timely
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_PORT=5432

# Bind the app privately for a host-level TLS reverse proxy.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# Optional: set registry image references instead of using the local build defaults.
# BACKEND_IMAGE=registry.example.com/timely/backend:latest
# FRONTEND_IMAGE=registry.example.com/timely/frontend:latest

# Optional browser push configuration.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@example.com

ENABLE_RECURRENCE_OVERRIDES=True
