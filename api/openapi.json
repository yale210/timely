components:
  schemas:
    AdminUserList:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        username:
          type: string
          maxLength: 255
        email:
          type: string
          format: email
          maxLength: 255
        is_staff:
          type: boolean
        is_superuser:
          type: boolean
        is_active:
          type: boolean
        date_joined:
          type: string
          format: date-time
          readOnly: true
        last_login:
          type: string
          format: date-time
          nullable: true
      required:
      - date_joined
      - email
      - id
      - username
    BlankEnum:
      enum:
      - ''
    Calendar:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        title:
          type: string
          maxLength: 500
        description:
          type: string
        categories:
          type: array
          items:
            type: integer
        estimated_minutes:
          type: integer
          maximum: 9223372036854775807
          minimum: 1
          format: int64
        start_time:
          type: string
          format: date-time
        deadline:
          type: string
          format: date-time
        importance:
          allOf:
          - $ref: '#/components/schemas/ImportanceEnum'
          minimum: 1
          maximum: 10
        completed:
          type: boolean
        parent_task:
          type: integer
          nullable: true
        allocation:
          nullable: true
        total_task_allocations:
          type: integer
          maximum: 9223372036854775807
          minimum: 0
          format: int64
      required:
      - deadline
      - estimated_minutes
      - id
      - importance
      - start_time
      - title
    CalendarResponse:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        title:
          type: string
          maxLength: 500
        description:
          type: string
        categories:
          type: array
          items:
            $ref: '#/components/schemas/Category'
          readOnly: true
        estimated_minutes:
          type: integer
          maximum: 9223372036854775807
          minimum: 1
          format: int64
        start_time:
          type: string
          format: date-time
        deadline:
          type: string
          format: date-time
        importance:
          allOf:
          - $ref: '#/components/schemas/ImportanceEnum'
          minimum: 1
          maximum: 10
        completed:
          type: boolean
        parent_task:
          type: integer
          nullable: true
      required:
      - categories
      - deadline
      - estimated_minutes
      - id
      - importance
      - start_time
      - title
    Category:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        text:
          type: string
          maxLength: 20
      required:
      - id
      - text
    Event:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        title:
          type: string
          maxLength: 500
        description:
          type: string
        location:
          type: string
          maxLength: 255
        categories:
          type: array
          items:
            type: integer
        start_time:
          type: string
          format: date-time
        end_time:
          type: string
          format: date-time
        recurrence_interval:
          nullable: true
          oneOf:
          - $ref: '#/components/schemas/RecurrenceIntervalEnum'
          - $ref: '#/components/schemas/BlankEnum'
          - $ref: '#/components/schemas/NullEnum'
        recurrence_end:
          type: string
          format: date
          nullable: true
        split_from_event_id:
          type: integer
          readOnly: true
        reminders:
          type: array
          items:
            $ref: '#/components/schemas/EventReminder'
      required:
      - id
      - split_from_event_id
    EventReminder:
