{
  "openapi": "3.0.0",
  "info": {
    "title": "Timely API",
    "description": "API specification for Timely scheduling webapp",
    "version": "0.0.0"
  },
  "security": [
    {
      "tokenApiKey": []
    }
  ],
  "servers": [
    {
      "name": "Development",
      "url": "http://localhost:8000/api/",
      "description": "Local Development server"
    },
    {
      "name": "Production",
      "url": "https://timely.subhan.work/api/",
      "description": "Production server"
    }
  ],
  "paths": {
  },
  "components": {
    "securitySchemes": {
      "tokenApiKey": {
        "description": "API key for token based authentication given from login endpoint. Prefix with 'Token '",
        "type": "apiKey",
        "name": "Authorization",
        "in": "header"
      }
    }
  }
}