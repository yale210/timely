          type: integer
          readOnly: true
        day_start:
          type: string
          format: time
        day_end:
          type: string
          format: time
        max_hours_study_per_day:
          type: integer
          maximum: 24
          minimum: 0
        days_off:
          type: array
          items:
            type: integer
      required:
      - id
    Profile:
      type: object
      properties:
        name:
          type: string
          maxLength: 255
        date_of_birth:
          type: string
          format: date
          nullable: true
        creation_date:
          type: string
          format: date-time
          readOnly: true
        slogan:
          type: string
          maxLength: 255
        bio:
          type: string
      required:
      - creation_date
      - name
    PushSubscription:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        endpoint:
          type: string
          format: uri
          maxLength: 500
        p256dh:
          type: string
          maxLength: 255
        auth:
          type: string
          maxLength: 255
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - auth
      - created_at
      - endpoint
      - id
      - p256dh
    RecurrenceIntervalEnum:
      enum:
      - daily
      - weekly
      - monthly
      - yearly
      type: string
      description: |-
        * `daily` - Daily
        * `weekly` - Weekly
        * `monthly` - Monthly
        * `yearly` - Yearly
    Register:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        username:
          type: string
          maxLength: 255
        email:
          type: string
          format: email
          maxLength: 255
        password:
          type: string
          writeOnly: true
          maxLength: 128
      required:
      - email
      - id
      - password
      - username
    ServerTimeResponse:
      type: object
      properties:
        server_time:
          type: string
      required:
      - server_time
    TestPermissionResponse:
      type: object
      properties:
        message:
          type: string
      required:
      - message
  securitySchemes:
    cookieAuth:
      type: apiKey
      in: cookie
      name: sessionid
    knoxApiToken:
      type: apiKey
      in: header
      name: Authorization
      description: Token-based authentication with required prefix "Token"
