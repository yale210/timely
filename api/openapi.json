        id:
          type: integer
          readOnly: true
        user:
          type: integer
          readOnly: true
        name:
          type: string
          description: Assessment name
          maxLength: 100
        category:
          type: integer
          nullable: true
        category_name:
          type: string
          nullable: true
          readOnly: true
        score:
          type: number
          format: double
          minimum: 0
        total_possible:
          type: number
          format: double
          minimum: 1
        percentage:
          type: number
          format: double
          readOnly: true
        date_achieved:
          type: string
          format: date
        time_spent_minutes:
          type: integer
          minimum: 0
