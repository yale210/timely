# Local backend development configuration.
# Generate a secret with: python3 -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=replace-with-a-unique-random-value
DEBUG=True

# SQLite is the simplest local default. The production Compose stack overrides this.
POSTGRES=False
DB_PATH=db.sqlite3

# Required only when POSTGRES=True.
POSTGRES_HOST=localhost
POSTGRES_USER=timely
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=timely
POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379/0

# Comma-separated values. Hosts omit the scheme; origins include it.
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

ENABLE_RECURRENCE_OVERRIDES=True

# Optional browser push configuration.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@example.com
