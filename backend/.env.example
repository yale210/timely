#Set to True if using PostgreSQL, False otherewise and will default to SQLite
POSTGRES=True

#PostgreSQL connection settings
SECRET_KEY=""
POSTGRES_HOST="postgres"
POSTGRES_USER="admin"
POSTGRES_PASSWORD="root"
POSTGRES_DB="django"
POSTGRES_PORT="5432"

# Redis URL
REDIS_URL=redis://localhost:6379/0

# Recurring event override system feature flag
# True: backend flattened recurring instances + scoped recurring mutations.
# False: legacy recurring behavior.
ENABLE_RECURRENCE_OVERRIDES=True

# VAPID Keys for Push Notifications
# Generate using: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@example.com

